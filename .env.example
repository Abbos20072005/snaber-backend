# --- Asosiy ---
SECRET_KEY=your-secret-key
# Serverda albatta False
DEBUG=True
# Serverda domenlar: snaber.uz,www.snaber.uz
ALLOWED_HOSTS=*
# Admin panel HTTPS domen orqali ochilsa: https://snaber.uz,https://www.snaber.uz
CSRF_TRUSTED_ORIGINS=

# --- Baza ---
# sqlite (standart, sinov uchun) yoki postgresql
DB_ENGINE=sqlite
DB_NAME=snaber
DB_USER=snaber
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# --- Frontend ---
# Brauzerdan API ga to'g'ridan-to'g'ri murojaat qiladigan saytlar
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Buyurtmalar ---
# Bitta manzildan qabul qilinadigan buyurtmalar soni
ORDERS_THROTTLE_RATE=10/hour
# Backend oldidagi proksilar soni (nginx, Next.js); serverda albatta yozing
NUM_PROXIES=
# locmem (bitta jarayon) yoki db (gunicorn workerlari uchun umumiy, createcachetable kerak)
CACHE_BACKEND=locmem

# --- Server (DEBUG=False bo'lganda) ---
# HTTP→HTTPS odatda nginx da; Django da faqat zarur bo'lsa True
SECURE_SSL_REDIRECT=False
# HTTPS barqaror ishlagach, masalan 31536000 (1 yil)
SECURE_HSTS_SECONDS=0
# Xatolar Sentry ga yuborilsin desangiz
SENTRY_DSN=
